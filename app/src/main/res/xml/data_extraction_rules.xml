<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12+.

   Same reasoning as backup_rules.xml: the AniList OAuth token lives in the
   DataStore preferences file, and neither cloud backup nor device-to-device
   transfer should carry a live session token to another machine.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/" />
    </device-transfer>
</data-extraction-rules>