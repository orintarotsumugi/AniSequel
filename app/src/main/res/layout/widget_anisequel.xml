<?xml version="1.0" encoding="utf-8"?>
<!--
  The placed widget.

  Two lines and a bar, deliberately. The tile can be squashed to 40dp tall, and a
  taller stack of text clips mid-word rather than degrading - so what survives the
  smallest size is the number itself.

  The whole tile is the tap target, with no dead margin around the text: the host
  routes a tap only to the view the `RemoteViews` attached the click to, so a
  layout whose text sat inside an unclickable box would look tappable and do
  nothing.

  This is also the `initialLayout` from `res/xml/widget_anisequel.xml`, which is
  what the host inflates before the first `onUpdate` arrives.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/widget_accent"
            android:layout_width="4dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_accent_bar"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/widget_count_initial"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_caption"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
