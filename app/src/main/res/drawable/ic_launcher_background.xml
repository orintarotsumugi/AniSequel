<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher icon background.

    A vector, and a gradient, rather than the flat #0F172A rectangle this used
    to be. The old value was close enough to black that the icon read as an
    empty dark square on a launcher - no branding at all, and the only thing
    distinguishing the app from a placeholder was the mark in the middle.

    The gradient runs through the two brand blues from Color.kt, so the icon and
    the app agree without either importing the other's values at build time.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item
                    android:offset="0"
                    android:color="#FF1E7FE0" />
                <item
                    android:offset="0.55"
                    android:color="#FF1673D6" />
                <item
                    android:offset="1"
                    android:color="#FF0B4F9E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>