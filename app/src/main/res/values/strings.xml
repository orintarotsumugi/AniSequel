<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">AniSequel</string>

    <!-- Activity screen is the fourth destination on the profile. -->
    <string name="profile_tab_activity">Activity</string>
    <string name="profile_activity_list">Activity</string>
    <string name="profile_activity_empty">No activity yet</string>

    <!-- Profile-activity widget. `widget_description` is what the Android 12+
         widget picker prints under the tile, so it is a sentence about the tile
         rather than a repeat of the app name. `widget_count_initial` is the text
         the initialLayout shows for the moment between the tile being placed and
         its first update. -->
    <string name="widget_description">Your recent AniList list activity, one tap from the home screen</string>
    <string name="widget_count_initial">0</string>
    <string name="widget_caption">recent updates</string>
    <string name="widget_caption_empty">nothing logged yet</string>

    <!-- Missed sequels widget -->
    <string name="widget_missed_description">Track missed franchise continuations from your home screen</string>
    <string name="widget_missed_caption">missed sequels</string>
    <string name="widget_missed_caption_empty">all caught up</string>

    <!-- Arriving sequels widget -->
    <string name="widget_arriving_description">Track arriving and airing sequel episodes from your home screen</string>
    <string name="widget_arriving_caption">arriving soon</string>
    <string name="widget_arriving_caption_empty">no upcoming airing</string>

    <!-- Featured Sequel widget. `widget_featured_title_initial` and
         `widget_featured_parent_initial` are what the initialLayout shows for the
         moment between the tile being placed and its first update. -->
    <string name="widget_featured_description">The top missed sequel, poster and all, on your home screen</string>
    <string name="widget_featured_title_initial">Featured sequel</string>
    <string name="widget_featured_parent_initial">Sequel to&#8230;</string>
    <string name="widget_featured_caption">missed sequels</string>
    <string name="widget_featured_caption_empty">all caught up</string>
    <string name="widget_featured_sequel_to">Sequel to %1$s</string>
</resources>
